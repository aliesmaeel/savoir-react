{
  "name": "savoir-mcp",
  "version": "0.3.3",
  "private": true,
  "description": "Savoir Properties MCP server (ChatGPT app / MCP Apps) backed by the Savoir CMS",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "inspector": "npx @modelcontextprotocol/inspector@latest",
    "smoke": "tsx scripts/smoke.ts",
    "preview:widget": "tsx scripts/preview-widget.ts",
    "release": "node scripts/package-release.mjs",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "submission:check": "node scripts/build-submission.mjs",
    "submission:build": "node scripts/build-submission.mjs --zip --check-urls",
    "smoke:journey": "tsx scripts/journey-smoke.ts",
    "insights": "tsx src/cli/insights.ts",
    "insights:hash-password": "tsx src/cli/insights.ts --hash-password"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
