# Savoir MCP server configuration. Copy to .env (never commit .env).

# Required. Origin of the Savoir CMS API (server-side only; separate from the
# website's VITE_BASE_URL).
CMS_BASE_URL=https://cms.savoirproperties.com

# Public website origin used for canonical listing links.
PUBLIC_SITE_URL=https://savoirproperties.com

# Bind address and port. Use 0.0.0.0 inside containers.
HOST=127.0.0.1
PORT=8787

# Comma-separated Host header allow-list (DNS-rebinding protection).
# Required in production, e.g. mcp.savoirproperties.com
ALLOWED_HOSTS=

# CMS request timeout (ms) and outbound budget. The CMS throttles at
# 60 requests/minute per client IP, so keep this below 60.
CMS_TIMEOUT_MS=8000
CMS_MAX_REQUESTS_PER_MINUTE=45

# Image hosts allowed in results and in the widget CSP (comma-separated).
# Defaults to the hosts verified on live CMS data:
# static.shared.propertyfinder.ae,res.cloudinary.com,savoirbucket.s3.eu-north-1.amazonaws.com
IMAGE_HOSTS=

# Inquiry submissions: disabled (default) | dry_run | live
#   disabled - submit_property_inquiry is not offered at all
#   dry_run  - full preview/confirmation flow, but nothing is sent to the CMS
#   live     - confirmed inquiries are POSTed to /api/contact-us (real leads!)
INQUIRY_MODE=disabled

# HMAC secret for inquiry confirmation tokens (>= 32 chars). Required when
# running more than one instance; otherwise a random per-process key is used.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INQUIRY_TOKEN_SECRET=

# Plain-text token from the OpenAI Platform domain-verification step; served at
# /.well-known/openai-apps-challenge
OPENAI_APPS_CHALLENGE_TOKEN=

# Optional dedicated widget origin (_meta.ui.domain), only if a host requires it.
WIDGET_DOMAIN=

# debug | info | warn | error
LOG_LEVEL=info
