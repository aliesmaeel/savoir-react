# Production settings for mcp.savoirproperties.com (read-only launch).
# On the server this file lives at <APP_ROOT>/shared/.env (chmod 600), outside releases.

CMS_BASE_URL=https://cms.savoirproperties.com
PUBLIC_SITE_URL=https://savoirproperties.com

# Bind to loopback only; nginx terminates TLS and proxies to this port.
HOST=127.0.0.1
PORT=8787
ALLOWED_HOSTS=mcp.savoirproperties.com

CMS_TIMEOUT_MS=8000
# The CMS throttles 60 req/min PER CLIENT IP. This server shares its public IP
# (31.97.190.32) with the website's server-side rendering, which also calls the
# CMS, so keep the MCP budget low until the CMS team exempts this IP.
CMS_MAX_REQUESTS_PER_MINUTE=20

# Read-only launch: the inquiry tool is not offered. deploy.sh refuses any other value.
INQUIRY_MODE=disabled

# Set after the OpenAI Platform shows the domain-verification token.
OPENAI_APPS_CHALLENGE_TOKEN=

# Public origin of this server, used in shortlist share links (/s/<token>).
PUBLIC_MCP_URL=https://mcp.savoirproperties.com

# Shortlists (listing references only, no personal data) are stored here, outside
# releases so they survive deploys. Leave empty to use APP_ROOT/shared/data.
DATA_DIR=

# utm_* tags on generated website links. Keep off until the website has analytics.
ATTRIBUTION_UTM=off

LOG_LEVEL=info
